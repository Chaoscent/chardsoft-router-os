# Chardsoft Router OS: IPv4 for the LAN over an IPv6-only connection
# (CLAT, 464XLAT). tayga translates between the clat interface and IPv6;
# the config (/etc/tayga/chaos-clat.conf) and when it runs come from the
# app (services/clat.py). Installed by deploy/install-service.sh; not
# enabled at boot, the app starts it when the WAN needs it.

[Unit]
Description=Chardsoft Router OS: IPv4 over IPv6 (CLAT)
Documentation=https://github.com/chaoscent/chardsoft-router-os
After=network.target

[Service]
Type=simple
ExecStartPre=-/usr/sbin/tayga --config /etc/tayga/chaos-clat.conf --mktun
ExecStart=/usr/sbin/tayga --config /etc/tayga/chaos-clat.conf --nodetach
ExecStopPost=-/usr/sbin/tayga --config /etc/tayga/chaos-clat.conf --rmtun
Restart=on-failure
RestartSec=5
